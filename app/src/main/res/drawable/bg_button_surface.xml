<?xml version="1.0" encoding="utf-8"?>
<!-- White button for use on a coloured block, where the soft purple button would disappear. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</ripple>

<?xml version="1.0" encoding="utf-8"?>
<!-- Shared appearance. The manifest selects Theme.ChemMe for the whole app. -->
<resources>
    <style name="Theme.ChemMe" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/orange</item>
        <item name="colorPrimaryDark">@color/orange_dark</item>
        <item name="colorAccent">@color/orange</item>
    </style>

    <!-- The main action on a screen: solid orange. -->
    <style name="PrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:backgroundTint">@color/orange</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Other actions: plain grey button with dark text. -->
    <style name="SecondaryButton" parent="Widget.AppCompat.Button">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Destructive actions such as Delete. -->
    <style name="DangerButton" parent="Widget.AppCompat.Button">
        <item name="android:textColor">@color/error</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">@color/grey</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="FieldError">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/error</item>
        <item name="android:textSize">13sp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="Heading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- A round coloured face with the character's initial in the middle. -->
    <style name="Face">
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/ic_default</item>
    </style>
</resources>

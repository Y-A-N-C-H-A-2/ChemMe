<?xml version="1.0" encoding="utf-8"?>
<!-- Shared appearance. The manifest selects Theme.ChemMe for the whole app. -->
<resources>
    <!-- DayNight follows the phone's light/dark setting; NoActionBar because each screen draws its own header. -->
    <style name="Theme.ChemMe" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/bg_brand</item>
        <item name="colorPrimaryDark">@color/bg_app</item>
        <item name="colorAccent">@color/bg_brand</item>
        <item name="android:windowBackground">@color/bg_app</item>
        <item name="android:statusBarColor">@color/bg_app</item>
        <item name="android:navigationBarColor">@color/bg_app</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <!-- Nunito everywhere, including dialogs and buttons. -->
        <item name="android:fontFamily">@font/nunito_medium</item>
        <item name="fontFamily">@font/nunito_medium</item>
    </style>

    <!-- ===== Text styles (the type scale from the design) ===== -->
    <style name="Text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Display">
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:textSize">32sp</item>
        <item name="android:lineSpacingMultiplier">1.05</item>
    </style>

    <style name="Text.H1">
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="Text.H2">
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Text.Title">
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Text.Body">
        <item name="android:fontFamily">@font/nunito_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Text.BodySmall">
        <item name="android:fontFamily">@font/nunito_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Text.Label">
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Text.Caption">
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Text.Number">
        <item name="android:fontFamily">@font/nunito_black</item>
        <item name="android:textSize">44sp</item>
    </style>

    <!-- ===== Buttons ===== -->
    <style name="ButtonBase" parent="Widget.AppCompat.Button">
        <item name="android:layout_height">52dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- The main action on a screen: solid brand colour. One per screen. -->
    <style name="PrimaryButton" parent="ButtonBase">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/text_on_brand</item>
    </style>

    <!-- Other actions: soft purple. -->
    <style name="SecondaryButton" parent="ButtonBase">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/text_brand</item>
    </style>

    <!-- A secondary action placed on a coloured block (the Home card). -->
    <style name="SurfaceButton" parent="ButtonBase">
        <item name="android:background">@drawable/bg_button_surface</item>
        <item name="android:textColor">@color/text_brand</item>
    </style>

    <!-- Destructive actions such as Delete. -->
    <style name="DangerButton" parent="ButtonBase">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@color/status_error</item>
    </style>

    <!-- Text-only action. -->
    <style name="GhostButton" parent="ButtonBase">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/text_brand</item>
    </style>

    <!-- ===== Small building blocks ===== -->
    <!-- Tappable choice or a small fact. Set isSelected in code to fill it. -->
    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- One circle of a 1 to 5 scale. -->
    <style name="ScaleOption">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_scale_option</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- What a character says. -->
    <style name="Bubble" parent="Text.Title">
        <item name="android:background">@drawable/bg_bubble</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <!-- White rounded card with a soft shadow. -->
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:elevation">2dp</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- 44dp round icon button. -->
    <style name="IconButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">@drawable/bg_circle_clear</item>
        <item name="tint">@color/text_primary</item>
    </style>

    <!-- The custom confirm dialog: no default frame, so the rounded panel shows. -->
    <style name="Theme.ChemMe.Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:fontFamily">@font/nunito_medium</item>
        <item name="fontFamily">@font/nunito_medium</item>
        <item name="colorAccent">@color/bg_brand</item>
    </style>
</resources>

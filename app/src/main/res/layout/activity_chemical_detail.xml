<?xml version="1.0" encoding="utf-8"?>
<!-- Chemical Detail: one character introduces itself, what it does, linked habits and the source. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- The background is tinted with the character's colour in ChemicalDetailActivity. -->
            <LinearLayout
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_mascot"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:id="@+id/imageMascot"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/textName"
                    style="@style/Text.H1"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/textCategory"
                    style="@style/Text.Body"
                    android:gravity="center"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/textHello"
                style="@style/Bubble"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp" />

            <LinearLayout
                style="@style/Card"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Title"
                    android:text="@string/heading_role" />

                <TextView
                    android:id="@+id/textRole"
                    style="@style/Text.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                style="@style/Card"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Title"
                    android:text="@string/heading_supported_by" />

                <TextView
                    android:id="@+id/textSupportedBy"
                    style="@style/Text.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <Button
                android:id="@+id/buttonSource"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:text="@string/button_source" />

            <TextView
                android:id="@+id/textSource"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

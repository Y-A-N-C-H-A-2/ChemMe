<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 6, Chemical Detail: the character, what the chemical does, linked habits and the source. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/face"
            style="@style/Face"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/textName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/grey"
            android:textSize="15sp" />

        <TextView style="@style/Heading" android:text="@string/heading_role" />

        <TextView
            android:id="@+id/textRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView style="@style/Heading" android:text="@string/heading_supported_by" />

        <TextView
            android:id="@+id/textSupportedBy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <Button
            android:id="@+id/buttonSource"
            style="@style/SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="@string/button_source" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/disclaimer"
            android:textColor="@color/grey"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>

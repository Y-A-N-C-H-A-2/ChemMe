<?xml version="1.0" encoding="utf-8"?>
<!-- History: the list of saved days, or the empty state when there are none. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        style="@style/Text.H1"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:text="@string/title_history" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerLogs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp" />

    <!-- Empty state: shown instead of the list when no day has been logged. -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_sera" />

        <TextView
            style="@style/Text.H2"
            android:layout_marginTop="12dp"
            android:text="@string/history_empty_title" />

        <TextView
            style="@style/Text.Body"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/history_empty_text"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/buttonLog"
            style="@style/PrimaryButton"
            android:layout_width="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/button_log_today" />
    </LinearLayout>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav" />
</LinearLayout>

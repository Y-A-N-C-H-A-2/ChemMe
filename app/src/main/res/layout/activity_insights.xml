<?xml version="1.0" encoding="utf-8"?>
<!-- Insights: the characters that showed up for one day, with Edit, Delete and Done. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- Success state after a save or an update. -->
            <TextView
                android:id="@+id/textBanner"
                style="@style/Text.Label"
                android:layout_width="match_parent"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_banner_success"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:text="@string/banner_saved"
                android:textColor="@color/status_success"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_check"
                app:drawableTint="@color/status_success" />

            <!-- The day's numbers as chips, added in InsightsActivity. -->
            <com.example.chemme.ui.FlowLayout
                android:id="@+id/chipsSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/textNote"
                style="@style/Text.BodySmall"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textHeading"
                style="@style/Text.Title"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:text="@string/insights_heading" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerInsights"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />

            <!-- Empty state: no rule matched this day. -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="24dp"
                android:visibility="gone">

                <TextView
                    style="@style/Bubble"
                    android:layout_width="match_parent"
                    android:text="@string/insights_empty" />

                <ImageView
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:layout_marginTop="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_gabby" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonEdit"
                style="@style/SecondaryButton"
                android:layout_width="0dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/button_edit" />

            <Button
                android:id="@+id/buttonDelete"
                style="@style/DangerButton"
                android:layout_width="0dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/button_delete" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonDone"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:text="@string/button_done" />
    </LinearLayout>
</LinearLayout>

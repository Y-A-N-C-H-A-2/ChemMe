<?xml version="1.0" encoding="utf-8"?>
<!-- Trends: sleep over the last days, the characters seen most, and one pattern in plain words. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Text.H1"
                android:text="@string/title_trends" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip7"
                    style="@style/Chip"
                    android:layout_marginEnd="8dp"
                    android:text="@string/trends_7_days" />

                <TextView
                    android:id="@+id/chip30"
                    style="@style/Chip"
                    android:text="@string/trends_30_days" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/Card"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Title"
                        android:text="@string/trends_sleep" />

                    <TextView
                        android:id="@+id/textSleepSubtitle"
                        style="@style/Text.BodySmall"
                        android:textColor="@color/text_secondary" />

                    <com.example.chemme.ui.BarChartView
                        android:id="@+id/chartSleep"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginTop="12dp" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Card"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Title"
                        android:text="@string/trends_visitors" />

                    <!-- Rows added in TrendsActivity. -->
                    <LinearLayout
                        android:id="@+id/listVisitors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/textNoVisitors"
                        style="@style/Text.BodySmall"
                        android:layout_marginTop="8dp"
                        android:text="@string/trends_no_visitors"
                        android:textColor="@color/text_secondary"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_sera" />

                    <TextView
                        android:id="@+id/textPattern"
                        style="@style/Bubble"
                        android:layout_width="0dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <!-- Empty state: nothing logged in the chosen period. -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="64dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_addy" />

                <TextView
                    style="@style/Text.H2"
                    android:layout_marginTop="12dp"
                    android:text="@string/trends_empty_title" />

                <TextView
                    style="@style/Text.Body"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/trends_empty_text"
                    android:textColor="@color/text_secondary" />

                <Button
                    android:id="@+id/buttonLog"
                    style="@style/PrimaryButton"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/button_log_today" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav" />
</LinearLayout>

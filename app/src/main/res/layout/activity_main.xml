<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 1, Home: greeting, today's status and the four main actions. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/faceHome"
                style="@style/Face"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/ic_sera"
                android:text="S"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/textGreeting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="@string/home_greeting"
                android:textColor="@color/ink"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textToday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:padding="20dp"
            android:text="@string/home_not_logged"
            android:textColor="@color/grey"
            android:textSize="16sp" />

        <Button
            android:id="@+id/buttonLog"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="@string/button_log_today" />

        <Button
            android:id="@+id/buttonHistory"
            style="@style/SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/button_history" />

        <Button
            android:id="@+id/buttonLibrary"
            style="@style/SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/button_library" />

        <Button
            android:id="@+id/buttonSettings"
            style="@style/SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/button_settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/disclaimer"
            android:textColor="@color/grey"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>

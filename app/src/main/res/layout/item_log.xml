<?xml version="1.0" encoding="utf-8"?>
<!-- One saved day in History: the date, a short summary and the characters that showed up. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="2dp"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="2dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_click"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textDay"
            style="@style/Text.Caption"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/textNumber"
            style="@style/Text.H2" />

        <TextView
            android:id="@+id/textMonth"
            style="@style/Text.Caption"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textSummary"
            style="@style/Text.Title"
            android:layout_width="match_parent" />

        <LinearLayout
            android:id="@+id/rowMascots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <ImageView android:id="@+id/mascot1" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="4dp" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/mascot2" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="4dp" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/mascot3" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="4dp" android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/textMore"
                style="@style/Text.Caption"
                android:layout_gravity="center_vertical"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron"
        app:tint="@color/text_secondary" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- One library card: the character, its name, the chemical and its category. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_card_click"
    android:elevation="2dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:id="@+id/imageMascot"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/textName"
        style="@style/Text.Title"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/textChemical"
        style="@style/Text.BodySmall"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/textCategory"
        style="@style/Text.Caption"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pill_alt"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:textColor="@color/text_secondary" />
</LinearLayout>

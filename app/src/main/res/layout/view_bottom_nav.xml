<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom navigation shared by Home, History, Trends and Library, with the round Log button in the middle. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@drawable/bg_nav"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:id="@+id/navHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_button_ghost"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:duplicateParentState="true"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_home"
            app:tint="@color/nav_item" />

        <TextView
            style="@style/Text.Caption"
            android:layout_marginTop="4dp"
            android:duplicateParentState="true"
            android:text="@string/nav_home"
            android:textColor="@color/nav_item" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navHistory"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_button_ghost"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:duplicateParentState="true"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_calendar"
            app:tint="@color/nav_item" />

        <TextView
            style="@style/Text.Caption"
            android:layout_marginTop="4dp"
            android:duplicateParentState="true"
            android:text="@string/title_history"
            android:textColor="@color/nav_item" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/navLog"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_brand"
            android:contentDescription="@string/button_log_today"
            android:elevation="3dp"
            android:padding="14dp"
            android:src="@drawable/ic_plus"
            app:tint="@color/text_on_brand" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/navTrends"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_button_ghost"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:duplicateParentState="true"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chart"
            app:tint="@color/nav_item" />

        <TextView
            style="@style/Text.Caption"
            android:layout_marginTop="4dp"
            android:duplicateParentState="true"
            android:text="@string/title_trends"
            android:textColor="@color/nav_item" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navLibrary"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_button_ghost"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:duplicateParentState="true"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_book"
            app:tint="@color/nav_item" />

        <TextView
            style="@style/Text.Caption"
            android:layout_marginTop="4dp"
            android:duplicateParentState="true"
            android:text="@string/nav_library"
            android:textColor="@color/nav_item" />
    </LinearLayout>
</LinearLayout>
